# ============================================================================
# NucleusArt production settings — lives ONLY on the server (/opt/nucleusart/deploy/.env.production).
# Create it with:  node deploy/create-env.mjs nucleusart.studio   (fills every secret below)
# Then fill in the "YOU" values. Never commit or share this file.
# ============================================================================

# ---- Site ----
# YOU: without https://, e.g. nucleusart.ai
DOMAIN=nucleusart.studio

# ---- Generated secrets (create-env.mjs fills these) ----
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
NEXTAUTH_SECRET=
CRON_SECRET=
INTERNAL_TASK_TOKEN=
API_ENCRYPTION_KEY=
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

# ---- EvoLink (central account) ----
# YOU: your live EvoLink key
EVOLINK_API_KEYS=
EVOLINK_LOW_BALANCE_CREDITS=2000
# YOU: where low-balance alerts go
ALERT_EMAIL=

# ---- Billing ----
# charge credits for every generation
BILLING_MODE=ENFORCE
# always Studio speed limits
ADMIN_USERNAMES=davdags

# ---- Email (Resend) — required: verification + password reset ----
# YOU: re_...
RESEND_API_KEY=
# YOU: a sender on your verified Resend domain
EMAIL_FROM=NucleusArt <hello@nucleusart.studio>

# ---- Google sign-in (optional; the button hides until both are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Paystack (later) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA4_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Whop — card checkout in USD next to Flutterwave (no webhook needed).
# API key: Whop dashboard > Developer > API keys. Company id starts with biz_.
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Naira is priced at this flat rate (other currencies follow the live rate +3%, see src/lib/payments/fx.ts).
USD_TO_NGN=1500
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_TWITTER_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
